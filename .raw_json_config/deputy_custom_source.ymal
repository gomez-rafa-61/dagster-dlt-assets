                    - "null"
                maxMetricAmount:
                  type:
                    - number
                    - "null"
                metricValueType:
                  type:
                    - string
                    - "null"
          success:
            type:
              - boolean
              - "null"
          locationid:
            type:
              - number
              - "null"
        additionalProperties: true
    transformations:
      - type: AddFields
        fields:
          - type: AddedFieldDefinition
            path:
              - locationid
            value: "{{ stream_partition.locationid }}"

spec:
  type: Spec
  connection_specification:
    type: object
    $schema: http://json-schema.org/draft-07/schema#
    required:
      - api_key_2
    properties:
      api_key_2:
        type: string
        order: 0
        title: API Key
        airbyte_secret: true
      roster_id:
        type: integer
        description: "1"
        order: 8
        title: Roster ID
      start_date:
        type: string
        description: "2022-06-01"
        order: 1
        title: Start Date
        format: date
        pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$
      roster_created_at_lookback_days:
        type: integer
        description: "-100 normally, but -1000 for initial seed load"
        order: 3
        title: Roster Created At Lookback Days
        default: "-100"
      employee_created_at_lookback_days:
        type: integer
        description: "-100 normally"
        order: 2
        title: Employee Created At Lookback Days
        default: "-100"
      timesheet_created_at_lookback_days:
        type: integer
        description: "-100 normally, but -1000 for initial seed load"
        order: 4
        title: Timesheet Created At Lookback Days
        default: "-100"
      labor_model_end_param_lookback_days:
        type: integer
        description: >-
          number of days to offset today and pass as the end parameter for labor
          model run
        order: 7
        title: Labor Model End Param Lookback Days
        default: "36"
      labor_model_start_param_lookback_days:
        type: integer
        description: >-
          number of days to offset today and pass as the start parameter for
          labor model run
        order: 6
        title: Labor Model Start Param Lookback Days
        default: "-1"
      timesheet_pay_return_created_at_lookback_days:
        type: integer
        order: 5
        title: Timesheet Pay Return Created At Lookback Days
        default: "-90"
    additionalProperties: true

