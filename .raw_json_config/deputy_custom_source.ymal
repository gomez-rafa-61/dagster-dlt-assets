  - type: DeclarativeStream
    name: labor_model_rule
    retriever:
      type: SimpleRetriever
      decoder:
        type: JsonDecoder
      requester:
        type: HttpRequester
        authenticator:
          $ref: "#/definitions/linked/HttpRequester/authenticator"
        http_method: GET
        error_handler:
          type: CompositeErrorHandler
          error_handlers:
            - type: DefaultErrorHandler
              response_filters:
                - type: HttpResponseFilter
                  action: IGNORE
                  http_codes:
                    - 400
        url: >-
          https://689d8628075027.na.deputy.com/api/v2/labor-model/location/{{
          stream_partition.locationid }}/rules
        request_body:
          type: RequestBodyJsonObject
          value:
            end: >-
              {{
              timestamp(day_delta(config['labor_model_end_param_lookback_days'],
              format='%Y-%m-%dT04:59:59')) }}
            start: >-
              {{
              timestamp(day_delta(config['labor_model_start_param_lookback_days'],
              format='%Y-%m-%dT05:00:00')) }}
      record_selector:
        type: RecordSelector
        extractor:
          type: DpathExtractor
          field_path: []
      partition_router:
        type: SubstreamPartitionRouter
        parent_stream_configs:
          - type: ParentStreamConfig
            stream:
              $ref: "#/streams/1"
            parent_key: Id
            partition_field: locationid
    schema_loader:
      type: InlineSchemaLoader
      schema:
        type: object
        $schema: http://json-schema.org/schema#
        properties:
          data:
            type:
              - array
              - "null"
            items:
              type:
                - object
                - "null"
              properties:
                id:
                  type:
                    - string
                    - "null"
                area:
                  type:
                    - number
                    - "null"
                steps:
                  type:
                    - array
                    - "null"
                metric:
                  type:
                    - string
                    - "null"
                buffers:
                  type:
                    - object
                    - "null"
                  properties:
                    open:
                      type:
                        - object
                        - "null"
                      properties:
                        hours:
                          type:
                            - number
                            - "null"
                        minutes:
                          type:
                            - number
                            - "null"
                        direction:
                          type:
                            - string
                            - "null"
                    close:
                      type:
                        - object
                        - "null"
                      properties:
                        hours:
                          type:
                            - number
                            - "null"
                        minutes:
                          type:
                            - number
                            - "null"
                        direction:
                          type:
                            - string
                            - "null"
                coverage:
                  type:
                    - number
                    - "null"
                maxLabor:
                  type:
                    - number
                    - "null"
                minLabor:
                  type:
                    - number
                    - "null"
                subMetric:
                  type:
                    - string
                    - "null"
                timeframe:
                  type:
                    - number
                    - "null"
                useBuffers:
                  type:
                    - boolean
                    - "null"
                laborAmount:
                  type:
                    - number
                    - "null"
