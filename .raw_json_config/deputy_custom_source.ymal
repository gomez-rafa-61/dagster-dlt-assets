version: 6.48.15

type: DeclarativeSource

check:
  type: CheckStream
  stream_names:
    - employee

definitions:
  linked:
    HttpRequester:
      authenticator:
        type: BearerAuthenticator
        api_token: "{{ config[\"api_key_2\"] }}"
      request_body:
        type: RequestBodyJsonObject
        value:
          sort:
            Modified: asc
          search:
            s1:
              type: gt
              data: "{{ stream_interval.start_time }}"
              field: Modified
    SimpleRetriever:
      paginator:
        type: DefaultPaginator
        page_token_option:
          type: RequestOption
          field_name: start
          inject_into: body_json
        pagination_strategy:
          type: OffsetIncrement
          inject_on_first_request: true

streams:
  - type: DeclarativeStream
    name: employee
    retriever:
      type: SimpleRetriever
      decoder:
        type: JsonDecoder
      paginator:
        $ref: "#/definitions/linked/SimpleRetriever/paginator"
      requester:
        type: HttpRequester
        authenticator:
          $ref: "#/definitions/linked/HttpRequester/authenticator"
        http_method: POST
        url: https://689d8628075027.na.deputy.com/api/v1/resource/Employee/QUERY
      record_selector:
        type: RecordSelector
        extractor:
          type: DpathExtractor
          field_path: []
    primary_key:
      - Id
    schema_loader:
      type: InlineSchemaLoader
      schema:
        type: object
        $schema: http://json-schema.org/schema#
        required:
          - Id
        properties:
          Id:
            type: number
          Role:
            type:
              - number
              - "null"
          Photo:
            type:
              - number
              - "null"
          Active:
            type:
