# Copy values into `.dlt/secrets.toml` (gitignored). Do not commit real credentials.
#
# MSSQL / Azure SQL — pick one style:
#
# [sources.mssqlserver]
# password = "..."
#
# Or a full SQLAlchemy URL (overrides split password from config):
# [sources.mssqlserver]
# connection_string = "mssql+pymssql://user:encoded_password@host:1433/database"
#
# Snowflake destination (align with `.raw_json_config/dest_raw_snowflake.json`):
# [destination.snowflake.credentials]
# ... see https://dlthub.com/docs/dlt-ecosystem/destinations/snowflake
#
# Deputy API (OAuth token / long-lived API key as Bearer):
# [sources.deputy]
# api_token = "..."
